@model IEnumerable<Store.Models.Book>

<h2>Книги</h2>

<a class="btn btn-success" asp-action="Create">Добавить книгу</a>

<table class="table">
    <tr>
        <th>Название</th>
        <th>Автор</th>
        <th>Жанр</th>
        <th>Издатель</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Authors</td>
            <td>@item.Genres</td>
            <td>@item.PublisherName</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Просмотр</a>
                <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a>

                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                    <button class="btn btn-link">Удалить</button>
                </form>
            </td>
        </tr>
    }
</table>