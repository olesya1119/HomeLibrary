@model IEnumerable<Store.Models.Genre>

<h2>Жанры</h2>

<a class="btn btn-success" asp-action="Create">Добавить</a>

<table class="table">
    <tr>
        <th>Название</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id">Просмотр</a>
                <a asp-action="Edit" asp-route-id="@item.Id">Изменить</a>

                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                    <button class="btn btn-link">Удалить</button>
                </form>
            </td>
        </tr>
    }
</table>