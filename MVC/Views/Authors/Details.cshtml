@model Store.Models.Author

<h2>@Model.FullName</h2>

<table class="table">
    <tr><td>Имя</td><td>@Model.FirstName</td></tr>
    <tr><td>Фамилия</td><td>@Model.LastName</td></tr>
    <tr><td>Отчество</td><td>@Model.MiddleName</td></tr>
    <tr><td>Дата рождения</td><td>@Model.BirthDate?.ToShortDateString()</td></tr>
    <tr><td>Дата смерти</td><td>@Model.DeathDate?.ToShortDateString()</td></tr>
    <tr><td>Описание</td><td>@Model.Description</td></tr>
</table>

<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Изменить</a>
<a class="btn btn-secondary" asp-action="Index">Назад</a>